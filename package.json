{
  "name": "voltgrid",
  "version": "1.0.0",
  "private": true,
  "description": "VoltGrid Smart EV Infrastructure DBMS & Full-Stack Application",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "build": "npm run build --workspace=server && npm run build --workspace=client",
    "build:server": "npm run build --workspace=server",
    "build:client": "npm run build --workspace=client",
    "test": "npm run test --workspace=server",
    "demo:concurrency": "tsx scripts/demo_concurrency.ts",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,emerald\" \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:build": "docker compose up --build -d",
    "docker:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
